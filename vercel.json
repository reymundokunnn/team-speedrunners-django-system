{
  "version": 2,
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "main_site/wsgi.py" }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "main_site.settings",
    "ENVIRONMENT": "production",
    "SESSION_ENGINE": "django.contrib.sessions.backends.db"
  },
  "git": {
    "deploymentEnabled": false
  }
}