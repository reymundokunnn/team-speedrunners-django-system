{
  "version": 1,
  "builds": [
    {
      "src": "main_site/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "10mb", "runtime": "python3.14" }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles_build" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "main_site/wsgi.py" }
  ]
}
